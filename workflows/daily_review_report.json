      "id": "b3a719a0-aab2-45fb-9ba0-7b8e94bfd244",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT count(*) AS total,\n       string_agg('- ' || title || ' (' || (current_date - created_at::date) || ' days): '\n                  || array_to_string(reasons, '; '), E'\\n' ORDER BY created_at) AS cvs\nFROM documents\nWHERE status = 'needs_review'\nHAVING count(*) > 0;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
